[config]
SCM_DO_BUILD_DURING_DEPLOYMENT=true
WEBSITE_NODE_DEFAULT_VERSION=~18

# Development-specific settings
WEBSITE_WEBDEPLOY_USE_SCM=true
WEBSITE_RUN_FROM_PACKAGE=1

# Minimal logging configuration
WEBSITE_HTTPLOGGING_ENABLED=true
WEBSITE_HTTPLOGGING_RETENTION_DAYS=3
WEBSITE_ENABLE_SYNC_LOGGING=false

# Development performance settings
WEBSITE_WEBDEPLOY_USE_SCM=true
WEBSITE_RUN_FROM_PACKAGE=1

# Container configuration
WEBSITES_CONTAINER_START_TIME_LIMIT=300
WEBSITES_PORT=3000

# Development scaling configuration
WEBSITE_AUTO_SCALE=false
WEBSITE_MIN_INSTANCES=0
WEBSITE_MAX_INSTANCES=1

# Cost optimization for development
WEBSITE_HTTPLOGGING_RETENTION_DAYS=3
WEBSITE_HTTPLOGGING_ENABLED=true
WEBSITE_ENABLE_SYNC_LOGGING=false

# Application Insights configuration
WEBSITE_APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key
APPLICATIONINSIGHTS_SAMPLING_PERCENTAGE=20

# Environment variables
NODE_ENV=development
PORT=3000

# Auto-shutdown settings
WEBSITE_IDLE_TIMEOUT=3600
WEBSITE_ALWAYS_ON=false 