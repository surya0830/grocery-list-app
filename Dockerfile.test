FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY GroceryApp/package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY GroceryApp/ .

# Copy test configuration
COPY GroceryApp/jest.config.js .
COPY GroceryApp/tsconfig.json .

# Run tests
CMD ["npm", "test"] 