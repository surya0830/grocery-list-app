# API URL - Replace with your actual server IP/domain
API_URL=http://192.168.1.100:8080/api

# Add any other environment variables needed by the app here 

# Azure App Service
AZURE_APP_NAME=your-app-name
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_LOCATION=westus
AZURE_NSG_NAME=your-nsg-name

# Azure Storage
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string

# Azure Key Vault
AZURE_KEY_VAULT=your-key-vault

# Azure Application Insights
AZURE_APPINSIGHTS_CONNECTION_STRING=your-appinsights-connection-string

# Security Settings
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png
RATE_LIMIT_TOKENS=100
RATE_LIMIT_REFILL_RATE=10
SAS_TOKEN_EXPIRY=5  # minutes
MAX_RETRIES=3
RETRY_TIMEOUT=10000  # ms
KEEP_ALIVE_INTERVAL=30000  # ms 